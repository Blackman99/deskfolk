{
  "name": "@real-bot/daemon",
  "license": "MIT",
  "private": true,
  "version": "0.1.0-rc.6",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "eval:tool-selection": "bun scripts/tool-selection-eval.ts",
    "compile": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --no-compile-autoload-tsconfig --no-compile-autoload-package-json src/main.ts --outfile dist/real-bot-daemon",
    "build:sidecar": "bun scripts/build-sidecar.ts",
    "check:db": "bun scripts/check-db.ts"
  },
  "dependencies": {
    "@real-bot/protocol": "workspace:*",
    "@real-bot/remote": "workspace:*",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "5.5.0",
    "https-proxy-agent": "^9.1.0",
    "proxy-from-env": "^2.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@xterm/xterm": "5.5.0",
    "typescript": "^6.0.3"
  }
}
