{
  "name": "@real-bot/daemon",
  "license": "MIT",
  "private": true,
  "version": "0.1.0-rc.14",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "dev:steady": "bun src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "eval:tool-selection": "bun scripts/tool-selection-eval.ts",
    "eval:goal-coverage": "bun scripts/goal-coverage-eval.ts",
    "eval:golden-path": "bun scripts/golden-path-eval.ts",
    "eval:golden-path:combine": "bun scripts/golden-path-combine.ts",
    "eval:protocol-probe": "bun scripts/protocol-probe.ts",
    "eval:model-probe": "bun scripts/model-probe.ts",
    "eval:cache-probe": "bun scripts/cache-probe.ts",
    "compile": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --no-compile-autoload-tsconfig --no-compile-autoload-package-json src/main.ts src/acceptance-match-worker.ts --outfile dist/real-bot-daemon",
    "build:sidecar": "bun scripts/build-sidecar.ts",
    "check:db": "bun scripts/check-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@real-bot/protocol": "workspace:*",
    "@real-bot/remote": "workspace:*",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/headless": "5.5.0",
    "https-proxy-agent": "^9.1.0",
    "proxy-from-env": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@xterm/xterm": "5.5.0",
    "typescript": "^6.0.3"
  }
}
