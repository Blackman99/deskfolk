<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The Windows shell's manifest, compiled into the exe by `build.rs` (resource 1 of type 24, the one
  Windows reads as a program starts). It says only what the shell already does in code, so that it holds
  from the first line on: per-monitor DPI awareness v2 (what NSH's `run_app` and the notification area
  icon's thread ask for), Windows 10 and 11 as the systems it is written for, and that it runs with the
  rights of whoever starts it. A malformed manifest stops the program from starting at all
  ("side-by-side configuration is incorrect"): `tests/windows_resources.rs` starts it.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
