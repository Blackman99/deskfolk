{
  "extends": "./.nsh/tsconfig.json",
  "compilerOptions": {
    // The browser's types too: the shared logic in src/m reaches browser APIs (the phone's page
    // runs in a browser). They used to come in through xterm's typings, which reference them.
    "lib": ["ES2023", "ESNext.Disposable", "DOM"],
    "allowImportingTsExtensions": true,
    "paths": {
      "nsh": ["./.nsh/types/nsh/index.d.ts"],
      "nsh/*": ["./.nsh/types/nsh/*.d.ts"],
      "@real-bot/protocol": ["../../../packages/protocol/src/index.ts"],
      "@real-bot/remote": ["../../../packages/remote/src/index.ts"],
      "*": ["./.nsh/types/*.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // The logic's own tests and their kits, as in the messenger they came from: `nsh test` runs the
  // `*.test.ts`, `bun test` the `*.spec.ts` (scripts/spec-setup.ts), neither with a type check, and
  // their hand-built fixtures predate fields the protocol added since.
  "exclude": ["e2e/**", "build/**", "src/m/**/*.test.ts", "src/m/**/*.spec.ts", "src/m/**/test-*.ts"]
}
