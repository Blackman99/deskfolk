{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:5173"
    ]
  },
  "permissions": [
    "core:default",
    "allow-local-api-endpoint",
    "allow-open-workspace-path",
    "allow-pick-workspace-folder",
    "allow-set-launch-at-login",
    "allow-independent-runtime-status",
    "allow-app-version",
    "allow-hide-main-window",
    "allow-check-for-update",
    "allow-open-external-url",
    "allow-notification-permission-state",
    "allow-request-notification-permission",
    "allow-take-notification-intent",
    "allow-report-notification-view",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
