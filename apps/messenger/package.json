  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/sanitize-html": "^2.16.1",
    "happy-dom": "^20.14.5",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
