{
  "name": "@real-bot/messenger",
  "license": "MIT",
  "private": true,
  "version": "0.1.0-rc.6",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "vite build",
    "build:hosted": "REAL_BOT_HOSTED=1 vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "test": "bun test --conditions browser src/lib tests/uno-utilities.test.ts",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@real-bot/protocol": "workspace:*",
    "@real-bot/remote": "workspace:*",
    "@shikijs/monaco": "^4.4.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.15",
    "fflate": "^0.8.3",
    "marked": "^18.0.13",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "6.3.289",
    "remend": "^1.3.1",
    "shiki": "^4.4.3",
    "svelte5plus-calendar": "0.5.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "happy-dom": "^20.14.5",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "unocss": "^66.10.5",
    "vite": "^8.0.16"
  }
}
